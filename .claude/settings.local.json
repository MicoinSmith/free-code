{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "anthropic/deepseek-chat"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:127.0.0.1)",
      "Bash(docker ps:*)",
      "Bash(docker exec:*)",
      "Bash(chmod +x:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(gh api:*)",
      "Bash(python3 -c \"import sys,json,base64; d=json.load\\(sys.stdin\\); print\\(base64.b64decode\\(d[''content'']\\).decode\\(\\)\\)\")",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(bun run:*)",
      "Bash(rm -rf /tmp/fprobe)",
      "Bash(~/.local/bin/free-code --version)",
      "Bash(./cli-dev --help)",
      "Bash(grep -n '\"\"dev\"\"' package.json)",
      "Bash(grep -rn \"function getDynamicConfig_BLOCKS_ON_INIT\\\\|getDynamicConfig_BLOCKS_ON_INIT\" src/utils/config.ts src/services/**/*.ts)",
      "Bash(grep -rn export.*getDynamicConfig_BLOCKS_ON_INIT -A 20 src/)",
      "Bash(grep -rn \"defaultMode\" src/utils/permissions/*.ts src/utils/settings/settings.ts src/main.tsx)",
      "Bash(./cli --version)",
      "Bash(./cli --help)",
      "Bash(ln -sfn /root/free-code/cli /root/.local/bin/free-code)",
      "Bash(cc --version)"
    ]
  }
}
